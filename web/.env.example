# Copy file ini jadi `web/.env.local` lalu isi nilainya.
# `.env.local` sudah di-ignore git — jangan pernah commit key asli.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key hanya dipakai di server (route handler / server action).
SUPABASE_SERVICE_ROLE_KEY=

# --- AI gateway ---
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://gateway.olagon.site/anthropic
AI_MODEL=claude-sonnet-5
# low|medium|high|xhigh|max. Kosong = low.
AI_EFFORT=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
